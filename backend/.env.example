NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=aihub
# Auto-create/alter tables from entities. NEVER enable in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT (min 32 chars each)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Optional: bootstrap an admin account on first start (skipped if email already exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
